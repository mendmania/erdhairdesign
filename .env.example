PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DATABASE_PATH=./data/salon.sqlite
SALON_TIMEZONE=Europe/Belgrade
# Production requires HTTPS, a Brevo API key, and a sender verified in Brevo.
NODE_ENV=development
# Use a Brevo API key from SMTP & API > API Keys (not an SMTP key).
BREVO_API_KEY=
EMAIL_FROM=ERD Hair Design <bookings@your-domain.com>
# Enable only behind the shared Caddy edge with the supplied network policy.
TRUST_PROXY=false
