# BEGIN ERD HAIR DESIGN
tregubio.com {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
    }
  }
  encode zstd gzip
  request_body {
    max_size 32KB
  }
  @health path /health/*
  handle @health {
    respond 404
  }
  @cloudflare {
    remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    header CF-Connecting-IP *
  }
  handle @cloudflare {
    reverse_proxy erdhairdesign.erdhairdesign.svc.cluster.local:3000 {
      header_up X-Erd-Client-IP {http.request.header.CF-Connecting-IP}
      header_up -Authorization
      header_up -X-Forwarded-For
      header_up -X-Real-IP
      header_up -True-Client-IP
      header_up -CF-Connecting-IP
      header_up -Forwarded
    }
  }
  handle {
    reverse_proxy erdhairdesign.erdhairdesign.svc.cluster.local:3000 {
      header_up X-Erd-Client-IP {remote_host}
      header_up -Authorization
      header_up -X-Forwarded-For
      header_up -X-Real-IP
      header_up -True-Client-IP
      header_up -CF-Connecting-IP
      header_up -Forwarded
    }
  }
}
# END ERD HAIR DESIGN
